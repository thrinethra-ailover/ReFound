# Supabase project credentials
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — Firebase Cloud Messaging browser configuration.
# Add these to .env.local to enable push subscription in local development.
# Firebase Console -> Project settings -> General -> Your apps (Web app)
# and Project settings -> Cloud Messaging -> Web Push certificates.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=

# The following are NOT VITE_-prefixed on purpose: they are server-side only
# secrets used by the notify-dispatch Supabase Edge Function, never bundled
# into client code. Set these with `supabase secrets set`, not in this file.
# See supabase/functions/notify-dispatch/README.md
# PUSH_WEBHOOK_SECRET=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=
